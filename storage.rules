rules_version = '2';

// Adjuntos: projects/{pid}/{tipo}/{archivo}. Lectura/escritura solo para miembros activos.
service firebase.storage {
  match /b/{bucket}/o {
    function isMember(pid) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/projects/$(pid)/members/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.active == true;
    }
    function isAdmin() {
      return request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.globalRole == 'admin';
    }

    match /projects/{pid}/{allPaths=**} {
      allow read: if isMember(pid) || isAdmin();
      allow create: if (isMember(pid) || isAdmin())
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf|video/.*');
      allow delete: if isAdmin();
    }
  }
}
