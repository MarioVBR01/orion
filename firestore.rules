rules_version = '2';

// ORION — reglas de seguridad. Toda regla de permisos vive aquí, no solo en la UI.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers globales ----------
    function signedIn() { return request.auth != null; }
    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function isActive() {
      return signedIn() && exists(userPath(request.auth.uid))
        && get(userPath(request.auth.uid)).data.active == true;
    }
    function globalRole() { return get(userPath(request.auth.uid)).data.globalRole; }
    function isAdmin() { return isActive() && globalRole() == 'admin'; }
    function canCreateProjects() { return isActive() && globalRole() in ['admin', 'project_manager']; }
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ---------- Helpers de proyecto ----------
    function projectPath(pid) { return /databases/$(database)/documents/projects/$(pid); }
    function memberPath(pid) { return /databases/$(database)/documents/projects/$(pid)/members/$(request.auth.uid); }
    function isMember(pid) { return isActive() && exists(memberPath(pid)); }
    function projectRole(pid) { return get(memberPath(pid)).data.role; }
    // admin global siempre pasa; el resto según su rol en el proyecto
    function roleIn(pid, roles) { return isAdmin() || (isMember(pid) && projectRole(pid) in roles); }
    function isPM(pid) { return roleIn(pid, ['project_manager']); }
    function canReadBoard(pid) { return roleIn(pid, ['project_manager', 'dev', 'qa', 'cliente', 'viewer']); }
    function canEditCards(pid) { return roleIn(pid, ['project_manager', 'dev', 'qa']); }

    function columns() {
      return ['backlog', 'por_hacer', 'en_progreso', 'revision_qa', 'revision_humano', 'hecho'];
    }
    function devColumns() { return ['backlog', 'por_hacer', 'en_progreso', 'revision_qa']; }

    // Flujo permitido por rol (admin/PM: todo; dev: hasta QA; qa: QA <-> Por hacer/Humano)
    function moveAllowed(pid, from, to) {
      return from == to
        || isPM(pid)
        || (projectRole(pid) == 'dev' && from in devColumns() && to in devColumns())
        || (projectRole(pid) == 'qa' && (
              (from == 'revision_qa' && to in ['por_hacer', 'revision_humano'])
              || (to == 'revision_qa' && from in ['por_hacer', 'revision_humano'])));
    }

    // ---------- Usuarios ----------
    function limitedRoles() { return ['dev', 'qa', 'cliente', 'tester']; }

    // Primer admin: solo si aún no existe meta/bootstrap y se crea en el mismo batch.
    function isBootstrap(uid) {
      return signedIn() && request.auth.uid == uid
        && request.resource.data.globalRole == 'admin'
        && request.resource.data.active == true
        && !exists(/databases/$(database)/documents/meta/bootstrap)
        && existsAfter(/databases/$(database)/documents/meta/bootstrap);
    }

    match /users/{uid} {
      allow read: if isActive() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (canCreateProjects() && request.resource.data.globalRole in limitedRoles())
        || isBootstrap(uid);
      allow update: if isAdmin()
        || (canCreateProjects()
            && resource.data.globalRole in limitedRoles()
            && request.resource.data.globalRole in limitedRoles())
        || (isActive() && request.auth.uid == uid && changedOnly(['name']));
      allow delete: if false;
    }

    match /meta/bootstrap {
      // público: la pantalla /setup necesita saber si ya existe el primer admin
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.globalRole == 'admin';
      allow update, delete: if false;
    }

    // Numeración global de proyectos (#6)
    match /meta/counters {
      allow read: if isActive();
      allow create: if canCreateProjects() && request.resource.data.project == 1;
      allow update: if canCreateProjects() && request.resource.data.project == resource.data.project + 1;
      allow delete: if false;
    }

    // ---------- Proyectos ----------
    match /projects/{pid} {
      allow read: if isAdmin() || (isActive() && request.auth.uid in resource.data.memberIds);

      allow create: if canCreateProjects()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberIds == [request.auth.uid]
        && request.resource.data.archived == false
        && request.resource.data.counters == {'card': 0, 'round': 0, 'observation': 0}
        && request.resource.data.number == getAfter(/databases/$(database)/documents/meta/counters).data.project;

      allow update: if (isPM(pid) && request.resource.data.number == resource.data.number)
        // cualquier miembro puede marcar/desmarcar su propia estrella
        || (isMember(pid) && changedOnly(['favoriteBy'])
            && request.resource.data.favoriteBy.toSet().difference(resource.data.favoriteBy.toSet()).hasOnly([request.auth.uid])
            && resource.data.favoriteBy.toSet().difference(request.resource.data.favoriteBy.toSet()).hasOnly([request.auth.uid]))
        // contadores (numeración de tarjetas/observaciones): solo pueden crecer
        || (roleIn(pid, ['dev', 'qa', 'cliente', 'tester']) && changedOnly(['counters'])
            && request.resource.data.counters.card >= resource.data.counters.card
            && request.resource.data.counters.round == resource.data.counters.round
            && request.resource.data.counters.observation >= resource.data.counters.observation);

      allow delete: if isAdmin();

      // Miembros
      function isCreatorBootstrap(uid) {
        return request.auth.uid == uid
          && !exists(projectPath(pid))
          && getAfter(projectPath(pid)).data.createdBy == request.auth.uid
          && request.resource.data.role == 'project_manager';
      }
      function validRole() {
        return request.resource.data.role in ['project_manager', 'dev', 'qa', 'cliente', 'tester', 'viewer'];
      }
      match /members/{uid} {
        allow read: if isMember(pid) || isAdmin();
        allow create: if validRole() && (isPM(pid) || (canCreateProjects() && isCreatorBootstrap(uid)));
        allow update: if validRole() && isPM(pid);
        allow delete: if isPM(pid);
      }

      // Tarjetas
      match /cards/{cardId} {
        allow read: if canReadBoard(pid);
        allow create: if canEditCards(pid)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.column in columns()
          && (request.resource.data.column != 'hecho' || isPM(pid))
          // el número debe salir del tramo de contador reservado en la misma escritura
          // (un batch puede crear varias tarjetas: aceptar propuesta de un round)
          && request.resource.data.number > get(projectPath(pid)).data.counters.card
          && request.resource.data.number <= getAfter(projectPath(pid)).data.counters.card;
        allow update: if canEditCards(pid)
          && request.resource.data.column in columns()
          && request.resource.data.number == resource.data.number
          && moveAllowed(pid, resource.data.column, request.resource.data.column);
        allow delete: if isPM(pid);

        match /comments/{id} {
          allow read: if canReadBoard(pid);
          allow create: if canEditCards(pid) && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if isActive() && resource.data.authorId == request.auth.uid;
        }
        match /history/{id} {
          allow read: if canReadBoard(pid);
          allow create: if canEditCards(pid)
            && request.resource.data.actorId == request.auth.uid
            && request.resource.data.projectId == pid;
          allow update, delete: if false;
        }
      }

      // Observaciones (Por revisar)
      function canReadObservation() {
        return roleIn(pid, ['project_manager', 'dev', 'qa'])
          || (roleIn(pid, ['cliente']) && resource.data.channel == 'clientes')
          || (roleIn(pid, ['tester']) && resource.data.channel == 'testers');
      }
      function channelAllowed() {
        return isAdmin()
          || (projectRole(pid) == 'cliente' && request.resource.data.channel == 'clientes')
          || (projectRole(pid) == 'tester' && request.resource.data.channel == 'testers')
          || (projectRole(pid) in ['project_manager', 'dev', 'qa']
              && request.resource.data.channel in ['clientes', 'testers']);
      }
      match /observations/{id} {
        allow read: if canReadObservation();
        allow create: if roleIn(pid, ['project_manager', 'dev', 'qa', 'cliente', 'tester'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.status == 'pendiente'
          && request.resource.data.kind in ['bug', 'mejora', 'duda']
          && channelAllowed();
        allow update: if isPM(pid)
          || (isActive() && resource.data.senderId == request.auth.uid
              && resource.data.status == 'pendiente'
              && request.resource.data.status == 'pendiente'
              && changedOnly(['title', 'kind', 'report', 'descriptionMd', 'attachments', 'updatedAt']));
        allow delete: if isPM(pid);

        match /comments/{cid} {
          allow read: if roleIn(pid, ['project_manager', 'dev', 'qa', 'cliente', 'tester']);
          allow create: if roleIn(pid, ['project_manager', 'dev', 'qa', 'cliente', 'tester'])
            && request.resource.data.authorId == request.auth.uid;
          allow update, delete: if false;
        }
      }

      // Rounds
      match /rounds/{id} {
        allow read: if roleIn(pid, ['project_manager', 'dev', 'qa']);
        allow write: if isPM(pid);
      }

      // Sprints
      match /sprints/{id} {
        allow read: if canReadBoard(pid);
        allow write: if isPM(pid);
      }

      // Versiones del brief
      match /briefVersions/{id} {
        allow read: if canReadBoard(pid);
        allow create: if isPM(pid);
        allow update, delete: if false;
      }

      // Versiones (releases)
      match /versions/{id} {
        allow read: if isMember(pid) || isAdmin();
        allow write: if isPM(pid);
      }

      // Casos de prueba
      match /testCases/{id} {
        allow read: if roleIn(pid, ['project_manager', 'dev', 'qa', 'tester']);
        allow create, delete: if roleIn(pid, ['project_manager', 'qa']);
        allow update: if roleIn(pid, ['project_manager', 'qa'])
          || (roleIn(pid, ['dev', 'tester'])
              && changedOnly(['status', 'executedBy', 'executedAt', 'resultNote']));
      }

      // Links
      match /links/{id} {
        allow read: if isMember(pid) || isAdmin();
        allow write: if isPM(pid);
      }
    }

    // Historial de todo el proyecto (consulta collectionGroup del botón 🕘)
    match /{path=**}/history/{id} {
      allow read: if canReadBoard(resource.data.projectId);
    }

    // ---------- Mensajes y notificaciones ----------
    match /messages/{id} {
      allow read: if isActive() && resource.data.toUid == request.auth.uid;
      allow create: if isActive()
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.fromUid in [request.auth.uid, 'system']
        && request.resource.data.read == false;
      allow update: if isActive() && resource.data.toUid == request.auth.uid && changedOnly(['read']);
      allow delete: if isActive() && resource.data.toUid == request.auth.uid;
    }
  }
}
